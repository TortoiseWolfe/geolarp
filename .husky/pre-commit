#!/bin/sh
# NOTE: this hook must never touch .next. CLAUDE.md tells you to commit from
# inside the container, where .next is the running dev server's — wiping it here
# 500s every route on every commit (#293). Nothing below reads .next anyway:
# gitleaks scans staged blobs, lint-staged runs eslint/prettier on staged files.
#
# THE INDEX THIS SCANS MUST BE THE ONE BEING COMMITTED (#747).
#
# `docker compose exec` enters the ALREADY-RUNNING container, whose /app is the
# primary checkout. A git worktree has its own index, so from a worktree that
# scanned the main tree's staged files instead of the ones being committed — and
# with a clean main tree, `gitleaks protect --staged` inspected an EMPTY index and
# exited 0. A green tick having measured nothing, which is worse than no hook.
#
# So anything that reads the index now prefers a host-native binary, which always
# sees the real checkout. Docker is the fallback, and is refused outright from a
# worktree rather than silently pointed at the wrong tree.

# `git rev-parse` disagrees with itself in a linked worktree: --git-dir is the
# worktree's own directory, --git-common-dir the shared one.
in_worktree() {
  [ "$(git rev-parse --git-dir 2>/dev/null)" != "$(git rev-parse --git-common-dir 2>/dev/null)" ]
}

# The running compose service, ASKED FOR RATHER THAN HARD-CODED.
#
# Both Docker branches below used to test `docker compose ps | grep -q scripthammer`.
# That is the fork trap in its purest form: a fork inherits a hook that looks for the
# UPSTREAM project's container, never finds it, and falls through — and here the
# fall-through was a warning and exit 0, so 129 files reached `main` prettier-dirty
# behind a green tick (#13). The literal was also two brand renames stale; a rename
# cannot break this version, because compose is the only thing that actually knows.
#
# `--status running` matters: a defined-but-stopped service must not be exec'd into.
compose_service() {
  docker compose ps --services --status running 2>/dev/null | head -1
}

# EXIT CODES ARE NOT ENOUGH TO TELL THESE APART, so invocability is checked first.
# Measured: `gitleaks protect` exits 1 for leaks found AND 1 for a bad config. A
# bare `if [ $? -ne 0 ]; then echo "Secrets detected"` therefore reported "env file
# not found" as a leak and sent the next person hunting one that did not exist.
SCAN_CLEAN=0
SCAN_LEAKS=1
SCAN_UNAVAILABLE=2

run_gitleaks_staged() {
  echo "🔐 Scanning staged files for secrets..."

  # The config is the one input whose absence would otherwise masquerade as a
  # leak, so it is checked separately and reported as what it is.
  if [ ! -f .gitleaks.toml ]; then
    echo "⚠️  .gitleaks.toml is missing — cannot scan."
    return $SCAN_UNAVAILABLE
  fi

  if command -v gitleaks >/dev/null 2>&1; then
    gitleaks protect --staged --config .gitleaks.toml --verbose
    [ $? -eq 0 ] && return $SCAN_CLEAN || return $SCAN_LEAKS
  fi

  if [ -x "node_modules/.bin/gitleaks" ]; then
    node_modules/.bin/gitleaks protect --staged --config .gitleaks.toml --verbose
    [ $? -eq 0 ] && return $SCAN_CLEAN || return $SCAN_LEAKS
  fi

  # Docker last, and never from a worktree — it would scan the primary checkout.
  if in_worktree; then
    echo "⚠️  No native gitleaks, and this is a git worktree."
    echo "   Docker would scan the PRIMARY checkout's index, not this one (#747)."
    return $SCAN_UNAVAILABLE
  fi

  GL_SERVICE="$(command -v docker >/dev/null 2>&1 && compose_service)"
  if [ -n "$GL_SERVICE" ]; then
    docker compose exec -T "$GL_SERVICE" pnpm run gitleaks:staged
    GL=$?
    # Distinguishable here: 126/127 mean the command could not be executed at all,
    # and compose reports a missing env file or absent container the same way.
    if [ $GL -eq 126 ] || [ $GL -eq 127 ]; then
      echo "⚠️  Could not execute gitleaks inside the container."
      return $SCAN_UNAVAILABLE
    fi
    [ $GL -eq 0 ] && return $SCAN_CLEAN || return $SCAN_LEAKS
  fi

  echo "⚠️  gitleaks not found on PATH, in node_modules/.bin, or via Docker."
  return $SCAN_UNAVAILABLE
}

run_gitleaks_staged
GITLEAKS_EXIT=$?

# BOTH OUTCOMES BLOCK. Only the message differs, because "we found a secret" and
# "we could not look" need different next actions from the person reading it.
if [ $GITLEAKS_EXIT -eq $SCAN_LEAKS ]; then
  echo "❌ Secrets detected! Commit blocked."
  exit 1
elif [ $GITLEAKS_EXIT -ne $SCAN_CLEAN ]; then
  echo "❌ Secret scan could NOT RUN — commit blocked. This is not a leak report."
  echo "   Install gitleaks (https://github.com/gitleaks/gitleaks) or start the"
  echo "   dev container, then commit again."
  exit 1
fi

# ---------------------------------------------------------------------------
# lint-staged — same wrong-index hazard, same ordering.
#
# `docker compose exec ... lint-staged` from a worktree would format the PRIMARY
# checkout's staged files. The issue only named this for gitleaks; it is the same
# mechanism, so it gets the same treatment.
# ---------------------------------------------------------------------------
echo "🔍 Running lint-staged..."

if [ -d "/app" ] && [ "$PWD" = "/app" ]; then
  echo "📦 Running inside Docker container..."
  pnpm exec lint-staged --no-stash
elif [ -x "node_modules/.bin/lint-staged" ]; then
  node_modules/.bin/lint-staged --no-stash
elif in_worktree; then
  echo "⚠️  No local lint-staged, and this is a git worktree."
  echo "   Skipping rather than formatting the primary checkout's files (#747)."
  echo "   Run prettier/eslint by hand on what you staged, per CLAUDE.md."
elif [ -n "$(command -v docker >/dev/null 2>&1 && compose_service)" ]; then
  echo "🐳 Running via Docker..."
  docker compose exec -T "$(compose_service)" pnpm exec lint-staged --no-stash
else
  # FAILS CLOSED, like the secret scan above, and for the same reason.
  #
  # This branch used to echo a warning and let the hook exit 0. Everything above
  # argues that "we could not look" must block just as hard as "we found something",
  # because a green tick that measured nothing is worse than no hook — and then this
  # line quietly disagreed. That inconsistency is #13: 129 files were committed
  # prettier-dirty, and the hook that would have caught them reported success.
  echo "❌ lint-staged could NOT RUN — commit blocked. Staged files were NOT formatted."
  echo "   Start the dev container (docker compose up) and commit again, or run"
  echo "   prettier and eslint over your staged files by hand first."
  exit 1
fi
